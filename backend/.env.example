# ===============================
# POSTGRESQL
# ===============================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=investlab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=investlab;Username=postgres;Password=changeme

# ===============================
# MONGO DB
# ===============================
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=investlab
MONGO_USER=
MONGO_PASSWORD=

# En Docker usar "mongo", no localhost
Mongo__ConnectionString=mongodb://mongo:27017
Mongo__Database=investlab

# ===============================
# JWT
# ===============================
Jwt__SecretKey=REPLACE_WITH_SECURE_KEY_MIN_64_CHARS
Jwt__Issuer=InvestLab.Api
Jwt__Audience=InvestLab.Client

# ===============================
# MARKET DATA PROVIDERS
# ===============================
MarketData__DefaultProvider=Yahoo
MarketData__Providers__Yahoo__Enabled=true
MarketData__Providers__Yahoo__BaseUrl=https://query1.finance.yahoo.com
MarketData__Providers__EodHistoricalData__Enabled=false
MarketData__Providers__EodHistoricalData__BaseUrl=https://eodhd.com/api
MarketData__Providers__EodHistoricalData__ApiKey=xxxxxxxxxxxxxxxxx

# ===============================
# LIMITES DE USO
# ===============================
Limits__MaxAlerts=10
Limits__MaxFavorites=10
Limits__MaxOperationsPerDay=20
Limits__MaxDailySearches=50
Limits__InitialBalance=10000

# ===============================
# EMAIL
# ===============================
Email__Provider=Resend
Email__ApiKey=re_xxxxxxxxxxxxxxxxx
Email__From=onboarding@resend.dev
Contact__Email=contacto@investlab.com