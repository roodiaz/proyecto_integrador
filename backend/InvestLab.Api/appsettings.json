{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "MarketData": {
    "DefaultProvider": "Yahoo",
    "Providers": {
      "Yahoo": {
        "Enabled": true,
        "BaseUrl": "https://query1.finance.yahoo.com"
      },
      "EodHistoricalData": {
        "Enabled": false,
        "BaseUrl": "https://eodhd.com/api",
        "ApiKey": ""
      }
    }
  },

  "Jwt": {
    "ExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Limits": {
    "MaxAlerts": 10,
    "MaxFavorites": 20,
    "MaxOperationsPerDay": 20,
    "MaxDailySearches": 20,
    "InitialBalance": 10000,
    "MaxFailedLoginAttempts": 3,
    "LockoutDurationMinutes": 10
  },

  "RateLimiting": {
    "Login": { "PermitLimit": 5, "WindowMinutes": 1 },
    "Register": { "PermitLimit": 5, "WindowMinutes": 60 },
    "PasswordRecovery": { "PermitLimit": 3, "WindowMinutes": 15 },
    "EmailChange": { "PermitLimit": 5, "WindowMinutes": 30 },
    "Contact": { "PermitLimit": 5, "WindowMinutes": 60 },
    "VerificationCode": { "PermitLimit": 5, "WindowMinutes": 15 }
  }
}